	protected $_icon = '%icon%';

	protected $_templates = array( '%type%', 'listselect' );

	protected $_test_value = '%test_value%';

	public function __construct()
	{
		parent::__construct();

		$this->_nicename = esc_html__( '%nicename%', '%text_domain%' );

		// The options of this element are fixed; hide the builder's option editor.
		$this->_settings[ 'options' ][ 'group' ] = '';

		$this->_settings[ 'default' ] = array(
