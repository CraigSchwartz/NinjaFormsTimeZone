	/**
	 * Option list for the builder's Default Value dropdown.
	 *
	 * @return array
	 */
	private function get_default_value_options()
	{
		$options = array();

		foreach ( $this->get_options() as $option ) {
			$options[] = array(
				'label' => $option[ 'label' ],
				'value' => $option[ 'value' ],
			);
		}

		return $options;
	}

	/**
	 * Replace the configured options with this element's fixed options.
	 *
	 * Ninja Forms runs the submitted value against this filtered list for
	 * server-side validation, so only the fixed options are accepted.
	 *
	 * @param array $options
	 * @param array $settings
	 * @return array
	 */
	public function filter_options( $options, $settings )
	{
		$default_value = ( isset( $settings[ 'default' ] ) ) ? $settings[ 'default' ] : '';

		$options = $this->get_options(); // Overwrite the default list options.
		foreach ( $options as $key => $option ) {
			if ( $default_value != $option[ 'value' ] ) continue;
			$options[ $key ][ 'selected' ] = 1;
		}

		return $options;
	}

	/**
	 * Render the value as a select when a submission is edited in the admin.
	 *
	 * @param int    $id
	 * @param string $value
	 * @return string
	 */
	public function admin_form_element( $id, $value )
	{
		$field = Ninja_Forms()->form()->get_field( $id );

		$options = $this->get_options();
		$options = apply_filters( 'ninja_forms_render_options', $options, $field->get_settings() );
		$options = apply_filters( 'ninja_forms_render_options_' . $this->_type, $options, $field->get_settings() );

		ob_start();
		echo "<select name='fields[$id]'>";
		foreach ( $options as $option ) {
			$selected = ( $option[ 'value' ] == $value ) ? ' selected' : '';
			echo "<option value='" . esc_attr( $option[ 'value' ] ) . "'" . $selected . ">" . esc_html( $option[ 'label' ] ) . "</option>";
		}
		echo "</select>";
		return ob_get_clean();
	}

	/**
	 * Show the option label in the submissions table.
	 *
	 * @param string $value
	 * @param object $field
	 * @return string
	 */
	public function custom_columns( $value, $field )
	{
		if ( $this->_name != $field->get_setting( 'type' ) ) return $value;

		foreach ( $this->get_options() as $option ) {
			if ( $value == $option[ 'value' ] ) return $option[ 'label' ];
		}

		return $value;
	}

	/**
	 * Show the option label in CSV exports.
	 *
	 * @param string $field_value
	 * @param object $field
	 * @return string
	 */
	public function filter_csv_value( $field_value, $field )
	{
		foreach ( $this->get_options() as $option ) {
			if ( $field_value == $option[ 'value' ] ) return $option[ 'label' ];
		}

		return $field_value;
	}
