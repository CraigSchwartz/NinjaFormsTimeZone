			'group'   => 'primary',
			'value'   => '',
		);

		add_filter( 'ninja_forms_custom_columns',                          array( $this, 'custom_columns'   ), 10, 2 );
		add_filter( 'ninja_forms_render_options_' . $this->_type,          array( $this, 'filter_options'   ), 10, 2 );
		add_filter( 'ninja_forms_subs_export_field_value_' . $this->_name, array( $this, 'filter_csv_value' ), 10, 2 );
	}

	/**
	 * The fixed option list of this element.
	 *
	 * The first entry is a placeholder with an empty value.
	 *
	 * @return array
	 */
	private function get_options()
	{
		$order = 0;
		$options = array(
			array(
				'label'    => '- ' . esc_html__( '%placeholder_label%', '%text_domain%' ) . ' -',
				'value'    => '',
				'calc'     => '',
				'selected' => 0,
				'order'    => $order,
			),
		);

%options_php%

		return $options;
